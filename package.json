{
  "name": "is-codex-run-out",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local, reversible Codex Desktop title-bar quota patch for Windows.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test",
    "inspect": "node scripts/cli.mjs inspect",
    "install:patch": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/direct-operation.ps1 -Operation patch",
    "status": "node scripts/cli.mjs status",
    "launch": "node scripts/cli.mjs launch",
    "restore": "node scripts/cli.mjs restore",
    "uninstall:patch": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/direct-operation.ps1 -Operation uninstall"
  },
  "dependencies": {
    "@electron/asar": "4.0.1"
  },
  "devDependencies": {
    "esbuild": "0.25.8"
  },
  "engines": {
    "node": ">=22.12"
  }
}
